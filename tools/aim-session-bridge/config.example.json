{
  "apiBaseUrl": "https://motorsportmanagement.vercel.app",
  "watchFolders": [
    "C:\\AIM_DATA"
  ],
  "recursive": true,
  "stableSeconds": 15,
  "scanIntervalSeconds": 5,
  "ignoreExistingOnFirstRun": true,
  "retryBaseSeconds": 60,
  "retryMaxSeconds": 3600,
  "stateFile": ".mm-aim-bridge-state.json",
  "statusFile": ".mm-aim-bridge-status.json",
  "deviceKey": "",
  "deviceKeyEnv": "MM_DEVICE_KEY",
  "timingProvider": "auto",
  "aimDllPath": "",
  "allowUnvalidatedTimingProvider": false,
  "productionImportPolicy": "aim_track_session_strict_v1"
}
